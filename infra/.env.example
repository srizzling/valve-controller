# Copy to .env (git-ignored) and delete the lines you do not use (an empty line would override a real environment variable).
# This file is the one place for Terraform's secrets.
# `make` loads it, and `node ../scripts/github-setup.mjs secrets` copies it into GitHub Actions secrets when you are ready.

# Terraform's own Cloudflare token (permissions are listed in versions.tf).
# For `make setup` it needs two more: Account API Tokens:Edit and Workers R2 Storage:Edit.
CLOUDFLARE_API_TOKEN=

# healthchecks.io project API key (read-write)
TF_VAR_healthchecks_api_key=

# Optional
TF_VAR_ntfy_token=
TF_VAR_tuya_local_key=

# Written by `make setup`: R2 keys that can only touch the state bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
