# Copy to .env (git-ignored) and delete the lines you do not use (an empty line would override a real environment variable).
# This file is the one place for Terraform's secrets.
# `make` loads it, and `node ../scripts/github-setup.mjs secrets` copies it into GitHub Actions secrets when you are ready.

# Start with ONE broad token here: Account API Tokens:Edit and Workers R2 Storage:Edit.
# `make setup` uses it, then `make token` creates the narrow token Terraform needs, saves it as
# CLOUDFLARE_API_TOKEN and keeps this one as CLOUDFLARE_SETUP_TOKEN.
CLOUDFLARE_API_TOKEN=

# healthchecks.io project API key (read-write)
TF_VAR_healthchecks_api_key=

# Smart Life app: Me > settings gear > Account and Security > User Code. Only scripts/tuya-local-key.py uses it.
TUYA_USER_CODE=

# Optional
TF_VAR_ntfy_token=

# Written by `make setup`: R2 keys that can only touch the state bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
