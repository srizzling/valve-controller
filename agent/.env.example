# Tuya device (find the local key via `python -m tinytuya wizard`)
TUYA_DEVICE_ID=
TUYA_LOCAL_KEY=
TUYA_IP=192.168.1.50
TUYA_VERSION=3.4
TUYA_DP=1

# Shared secret the Worker sends as a Bearer token. Generate with: openssl rand -hex 32
AGENT_TOKEN=

# Hard ceiling on a single open() even if the Worker asks for more
MAX_ON_SECONDS=1800

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels). Point the public hostname at http://agent:8080
TUNNEL_TOKEN=
