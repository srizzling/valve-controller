  "cards": [
    {
      "dot": "cyan",
      "title": "Who can reach what",
      "items": [
        "The UI and /api sit behind Cloudflare Access, and the Worker re-checks the token",
        "Google Home bypasses Access on /oauth and /google, using its own signed tokens",
        "The agent is only reachable through the tunnel, with a bearer token"
      ]
    },
    {
      "dot": "emerald",
      "title": "One brain, one failsafe",
      "items": [
        "The Controller keeps run state and uses alarms for the 10-minute and 5-minute phases",
        "Every open carries a duration, so the agent timer closes the valve if Cloudflare is lost"
      ]
    },
    {
      "dot": "rose",
      "title": "Alerts come from three places",
      "items": [
        "Controller sends ntfy on start, finish, skip and failure, plus a preflight 10 minutes before",
        "healthchecks.io alerts when a scheduled run never reports in",
        "The agent sends its own ntfy when its failsafe timer fires"
      ]
    },
    {
      "dot": "amber",
      "title": "Provisioning",
      "items": [
        "infra/ (Terraform) creates the Worker, cron, Access, tunnel, DNS and the check; GitHub Actions applies it on every merge to main",
        "Terraform state is kept in a private R2 bucket, never in git",
        "infra/homelab runs the agent and cloudflared; CI cannot reach the homelab, so it is applied by hand"
      ]
    }
  ]
